{
  "path": [
    "src",
    "src-tauri/src",
    "server/mcp/src",
    "server/content/src"
  ],
  "format": ["typescript", "tsx", "jsx", "javascript", "rust", "css"],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/target/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.test.rs",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.bench.ts",
    "**/__tests__/**",
    "**/__golden__/**",
    "**/__snapshots__/**",
    "**/*.d.ts",
    "**/fixtures/**",
    "src/locales/**",
    "src/assets/**"
  ],
  "reporters": ["console", "html", "json", "markdown"],
  "output": "reports/duplication",
  "minTokens": 50,
  "minLines": 5,
  "gitignore": true,
  "absolute": false
}
