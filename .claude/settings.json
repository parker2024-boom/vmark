{
  "permissions": {
    "allow": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/gha-tdd-guard.mjs"
          },
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/multi-format-tdd-guard.mjs"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "tdd-guardian@xiaolai": true,
    "docs-guardian@xiaolai": true,
    "typescript-lsp@claude-plugins-official": true,
    "vmark-lsp@vmark-local": true,
    "frontend-design@claude-plugins-official": true,
    "english-buddy@xiaolai": true
  }
}
